        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (outcome) (rate(sfo_ai_rag_requests_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
