{
  "id": null,
  "uid": "sfo-ai-assistant",
  "title": "SmartFoodOps — AI Assistant",
  "description": "The conversational assistant, order explanations and partner tools (Week 5, D63-D64): usage, answer quality, latency, provider health and what the assistant returns commercially.",
  "tags": [
    "smartfoodops",
    "week5",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Questions asked",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(sfo_ai_assistant_requests_total[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "description": "AI assistant usage: every question that reached the router, in the selected time range."
    },
    {
      "id": 2,
      "title": "Answer rate",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(sfo_ai_assistant_requests_total{outcome=~\"answered|fallback\"}[$__range])) / clamp_min(sum(increase(sfo_ai_assistant_requests_total[$__range])), 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "description": "Questions that ended in an answer (a model answer, or the rule-written one after the guardrail). Declined and nothing-found questions count as asked but not answered."
    },
    {
      "id": 3,
      "title": "First token p95",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sfo_ai_assistant_first_token_seconds_bucket[5m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "description": "What the user feels: time from the question to the first streamed word."
    },
    {
      "id": 4,
      "title": "Guardrail replacement rate",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(sfo_ai_assistant_requests_total{outcome=\"fallback\"}[$__range])) / clamp_min(sum(increase(sfo_ai_assistant_requests_total{outcome=~\"answered|fallback\"}[$__range])), 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "description": "Share of model answers the grounding check rejected. A rising rate means the model is drifting from the retrieved context."
    },
    {
      "id": 5,
      "title": "Recommendation acceptance rate",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(sfo_ai_attributed_orders_total[$__range])) / clamp_min(sum(increase(sfo_ai_recommending_interactions_total[$__range])), 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "description": "Attributed orders per answer that named a restaurant. Attribution, not causation: an order counts if the customer ordered from a recommended restaurant within the window, whether or not the recommendation changed their mind."
    },
