{
  "id": null,
  "uid": "sfo-eventing-outbox",
  "title": "SmartFoodOps \u2014 Eventing & Outbox",
  "description": "The transactional-outbox relay (D39), the analytics/notification consumers reading sfo.order.events.v1, and the RabbitMQ hop notifications ride to Celery (D45). Kafka's own broker has no Prometheus exporter in this stack, so it's observed here through its consequences -- backlog, lag, consumer freshness -- rather than broker-internal metrics.",
  "tags": [
    "smartfoodops",
    "week3"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Outbox backlog (unpublished rows)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sfo_outbox_backlog",
          "refId": "A",
          "legendFormat": "{{job}} / {{outbox_table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "description": "Should hover near zero -- the relay drains on a ~1s cadence. A sustained climb means the relay can't reach Kafka; checkout keeps working regardless (D38/D39)."
    },
    {
      "id": 2,
      "title": "Outbox lag (oldest unpublished row)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sfo_outbox_lag_seconds",
          "refId": "A",
          "legendFormat": "{{job}} / {{outbox_table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Outbox publish rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (job, outbox_table) (rate(sfo_outbox_published_total[5m]))",
          "refId": "A",
          "legendFormat": "{{job}} / {{outbox_table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Outbox publish failures",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (job, outbox_table) (rate(sfo_outbox_publish_failures_total[5m]))",
          "refId": "A",
          "legendFormat": "{{job}} / {{outbox_table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "description": "Non-fatal by design (D39) -- attempts climbs and this alarms, but checkout is never blocked on it."
    },
    {
      "id": 5,
      "title": "Consumer staleness (time since last message)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "time() - sfo_consumer_last_message_timestamp_seconds",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "description": "A wedged consumer is a flat, climbing line here rather than silence -- the whole point of this gauge over a fire-and-forget daemon thread."
    },
    {
      "id": 6,
      "title": "Notifications enqueued by channel/status",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (channel, status) (rate(sfo_notifications_enqueued_total[5m]))",
          "refId": "A",
          "legendFormat": "{{channel}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "RabbitMQ queue depth",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rabbitmq_queue_messages_ready",
          "refId": "A",
          "legendFormat": "ready"
        },
        {
          "datasource": "Prometheus",
          "expr": "rabbitmq_queue_messages_unacked",
          "refId": "B",
          "legendFormat": "unacked"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "RabbitMQ consumers",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rabbitmq_queue_consumers",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 9,
      "title": "RabbitMQ connections",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rabbitmq_connections",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    }
  ]
}